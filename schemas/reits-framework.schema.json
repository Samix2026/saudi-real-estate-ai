{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Saudi REITs Framework",
  "description": "Schema for validating the Saudi Real Estate Investment Trusts regulatory framework in data/reits-framework.ar.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "description_ar",
    "regulatory_authorities",
    "concepts",
    "investor_rights",
    "listing_requirements"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "description_ar": { "type": "string", "minLength": 10 },
    "regulatory_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name_ar", "name_en", "role_ar", "url"],
        "properties": {
          "name_ar": { "type": "string", "minLength": 3 },
          "name_en": { "type": "string", "minLength": 3 },
          "role_ar": { "type": "string", "minLength": 10 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concept_ar", "concept_en", "definition_ar", "definition_en", "key_distinction_ar", "source_url", "last_verified", "audience"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "concept_ar": { "type": "string", "minLength": 3 },
          "concept_en": { "type": "string", "minLength": 3 },
          "definition_ar": { "type": "string", "minLength": 20 },
          "definition_en": { "type": "string", "minLength": 20 },
          "key_distinction_ar": { "type": "string", "minLength": 10 },
          "source_url": { "type": "string", "format": "uri" },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "audience": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "investor_rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "right_ar", "right_en", "legal_basis_ar", "source_url", "last_verified"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "right_ar": { "type": "string", "minLength": 5 },
          "right_en": { "type": "string", "minLength": 5 },
          "legal_basis_ar": { "type": "string", "minLength": 10 },
          "source_url": { "type": "string", "format": "uri" },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "listing_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ar", "requirement_en", "detail_ar", "source_url", "last_verified"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "requirement_ar": { "type": "string", "minLength": 5 },
          "requirement_en": { "type": "string", "minLength": 5 },
          "detail_ar": { "type": "string", "minLength": 10 },
          "source_url": { "type": "string", "format": "uri" },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
