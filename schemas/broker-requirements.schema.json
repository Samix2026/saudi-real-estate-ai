{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Saudi Real Estate Broker Requirements",
  "description": "Schema for validating REGA broker requirement entries in data/broker-requirements.ar.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "source_authority",
    "source_url",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the schema used"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO 8601 date of last dataset update"
    },
    "source_authority": {
      "type": "string",
      "description": "The official authority that governs these requirements"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Official URL for the broker licensing requirements"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_ar",
          "name_en",
          "category",
          "mandatory",
          "description_ar",
          "description_en",
          "source_url",
          "last_verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Unique snake_case identifier for the requirement"
          },
          "name_ar": {
            "type": "string",
            "minLength": 2,
            "description": "Requirement name in Arabic"
          },
          "name_en": {
            "type": "string",
            "minLength": 2,
            "description": "Requirement name in English"
          },
          "category": {
            "type": "string",
            "enum": [
              "ترخيص",
              "تأهيل",
              "تسجيل",
              "عقود",
              "أخلاقيات",
              "إجراءات"
            ],
            "description": "Category of the broker requirement"
          },
          "mandatory": {
            "type": "boolean",
            "description": "Whether this requirement is legally mandatory"
          },
          "description_ar": {
            "type": "string",
            "minLength": 20,
            "description": "Requirement description in Arabic"
          },
          "description_en": {
            "type": "string",
            "minLength": 20,
            "description": "Requirement description in English"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Official URL confirming this requirement"
          },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "ISO 8601 date of last verification"
          }
        }
      }
    }
  }
}
